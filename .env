# Dark Web Intelligence API Configuration
# Last Updated: April 2, 2026

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=false

# API Configuration
PORT=5002
SECRET_KEY=darkweb-intel-secret-key-2026
API_KEY=threat-intel-api-key-test

# Database Configuration
DB_PATH=threats.db
DB_TYPE=sqlite

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=api.log

# Threat Intelligence Configuration
THREAT_GENERATION_COUNT=200
AUTO_REFRESH_INTERVAL=30

# Advanced Features
ENABLE_ANALYTICS=true
ENABLE_CORRELATIONS=true
ENABLE_PREDICTIVE=true
ENABLE_EXPORT=true
CACHE_TTL=300
